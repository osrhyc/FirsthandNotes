---
import { getPostUrlBySlug, url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

interface Chapter {
	number: number;
	title: string;
	postSlug: string;
}

interface Book {
	slug: string;
	title: string;
	author: string;
	chapters: Chapter[];
}

interface Props {
	book: Book;
	currentChapterIndex: number;
}

const { book, currentChapterIndex } = Astro.props;
---

<aside
	id="book-sidebar"
	class="col-span-2 row-end-3 mb-4 w-full lg:col-span-1 lg:row-end-2 lg:row-start-1 lg:max-w-[17.5rem]"
>
	<div class="card-base overflow-hidden lg:sticky lg:top-4">
		<header class="border-b border-black/5 px-4 py-4 dark:border-white/10">
			<a
				href={url(`/books/${book.slug}/`)}
				class="group flex items-start gap-3"
				title={`查看《${book.title}》书籍首页`}
			>
				<div class="flex h-10 w-9 shrink-0 items-center justify-center rounded-md bg-[var(--btn-regular-bg)] font-bold text-[var(--primary)]">
					{book.title.slice(0, 1)}
				</div>
				<div class="min-w-0 flex-1">
					<h2 class="line-clamp-2 text-sm font-bold leading-5 text-90 transition group-hover:text-[var(--primary)]">
						{book.title}
					</h2>
					<p class="mt-1 truncate text-xs text-50">{book.author}</p>
				</div>
				<Icon name="material-symbols:chevron-right-rounded" class="mt-2 shrink-0 text-lg text-30" />
			</a>
		</header>

		<div class="flex items-center justify-between px-4 py-3 text-xs">
			<span class="font-semibold text-75">章节目录</span>
			<span class="text-30">{currentChapterIndex + 1} / {book.chapters.length}</span>
		</div>

		<ol class="max-h-80 overflow-y-auto border-t border-black/5 py-2 dark:border-white/10 lg:max-h-[calc(100vh-12rem)]">
			{book.chapters.map((chapter, index) => {
				const isCurrent = index === currentChapterIndex;
				return (
					<li>
						<a
							href={getPostUrlBySlug(chapter.postSlug)}
							aria-current={isCurrent ? "page" : undefined}
							class:list={[
								"group mx-2 flex min-h-10 items-start gap-2 rounded-lg px-2 py-2 text-sm transition",
								isCurrent
									? "bg-[var(--btn-regular-bg)] font-semibold text-[var(--primary)]"
									: "text-50 hover:bg-[var(--btn-plain-bg-hover)] hover:text-75",
							]}
						>
							<span class="w-6 shrink-0 pt-0.5 text-center font-mono text-xs opacity-60">
								{String(chapter.number || index + 1).padStart(2, "0")}
							</span>
							<span class="min-w-0 flex-1 leading-5">{chapter.title}</span>
						</a>
					</li>
				);
			})}
		</ol>
	</div>
</aside>
