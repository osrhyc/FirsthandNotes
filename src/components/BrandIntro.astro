---
import { Icon } from "astro-icon/components";
import { url } from "../utils/url-utils";
---

<section class="card-base mb-4 px-6 py-6 md:px-8 md:py-7 onload-animation">
	<div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
		<div class="flex min-w-0 items-center gap-5">
			<div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-xl bg-[#f7f4ed] p-2 md:h-24 md:w-24">
				<img src={url("/assets/brand/logo.png")} alt="一手笔记 Logo" class="h-full w-full object-contain" />
			</div>
			<div class="min-w-0">
				<h1 class="text-3xl font-bold text-[var(--brand-navy)] dark:text-white md:text-4xl">
					一手笔记
				</h1>
				<p class="mt-1 text-base font-medium text-50">Firsthand Notes</p>
				<div class="mt-3 flex items-center gap-3">
					<span class="h-px w-8 bg-[var(--brand-gold)]"></span>
					<p class="text-sm text-75 md:text-base">记录值得长期保存的知识</p>
				</div>
			</div>
		</div>

		<nav class="flex shrink-0 gap-2" aria-label="内容入口">
			<a href={url("/books/")} class="btn-regular flex h-10 items-center gap-2 rounded-lg px-4 text-sm font-medium active:scale-95">
				<Icon name="material-symbols:menu-book-outline-rounded" class="text-lg" />
				<span>精读书库</span>
			</a>
			<a href={url("/archive/")} class="btn-plain flex h-10 items-center gap-2 rounded-lg px-4 text-sm font-medium active:scale-95">
				<Icon name="material-symbols:archive-outline-rounded" class="text-lg" />
				<span>全部笔记</span>
			</a>
		</nav>
	</div>
</section>
