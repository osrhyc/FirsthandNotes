---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { BRIEFING_TOPICS, getBriefings } from "@utils/briefing-utils";
import { Icon } from "astro-icon/components";

export function getStaticPaths() {
	return BRIEFING_TOPICS.map((topic) => ({
		params: { topic: topic.slug },
		props: { topic },
	}));
}

const { topic } = Astro.props;
const topicTags = new Set<string>(topic.tags);
const briefings = (await getBriefings()).filter((briefing) =>
	briefing.tags.some((tag) => topicTags.has(tag)),
);
---

<MainGridLayout title={`晨读主题：${topic.name}`} description={`晨读中的${topic.name}内容。`}>
	<header class="card-base mb-4 px-6 py-6 md:px-8">
		<p class="text-sm font-semibold text-[var(--primary)]">BRIEFING TOPIC</p>
		<h1 class="mt-1 text-2xl font-bold text-90 md:text-3xl">{topic.name}</h1>
		<p class="mt-2 text-sm text-50">{briefings.length} 期相关晨读</p>
	</header>
	<div class="card-base overflow-hidden">
		{briefings.length ? (
			<ol class="divide-y divide-[var(--line-divider)]">
				{briefings.map((briefing) => (
					<li>
						<a href={briefing.url} class="group flex items-center gap-4 px-6 py-5 transition hover:bg-[var(--btn-plain-bg-hover)] md:px-8">
							<time class="w-24 shrink-0 text-sm text-30">{briefing.date}</time>
							<div class="min-w-0 flex-1">
								<h2 class="font-semibold text-75 transition group-hover:text-[var(--primary)]">{briefing.title}</h2>
								<p class="mt-1 line-clamp-1 text-sm text-50">{briefing.description}</p>
							</div>
							<Icon name="material-symbols:chevron-right-rounded" class="shrink-0 text-xl text-30" />
						</a>
					</li>
				))}
			</ol>
		) : (
			<p class="px-6 py-10 text-center text-sm text-50">暂无相关晨读</p>
		)}
	</div>
</MainGridLayout>
