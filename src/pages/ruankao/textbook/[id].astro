---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import RuankaoTextbookQuiz from "@components/RuankaoTextbookQuiz.svelte";
import { TEXTBOOK_LESSONS } from "@/data/ruankao-textbook";
import { TEXTBOOK_CHAPTERS } from "@/data/ruankao-chapters";
import type { TextbookLesson } from "@/data/ruankao-textbook-types";
export function getStaticPaths() {
  return TEXTBOOK_LESSONS.map(lesson => ({ params: { id: lesson.id }, props: { lesson } }));
}
interface Props { lesson: TextbookLesson }
const { lesson } = Astro.props;
const index = TEXTBOOK_LESSONS.findIndex(item => item.id === lesson.id);
const previous = TEXTBOOK_LESSONS[index - 1];
const next = TEXTBOOK_LESSONS[index + 1];
const chapter = TEXTBOOK_CHAPTERS.find(item => item.number === lesson.chapter);
const pageLabel = (a: number, b: number) => a === b ? `${a}` : `${a}—${b}`;
const sectionLabel = (id: string) => id.split("-")[0];
---
<MainGridLayout title={`${lesson.title} · 教材精读`} description={lesson.summary} fullWidth>
  <div class="textbook-study">
    <header class="study-hero">
      <a href="/ruankao/?tab=chapters" data-no-swup class="back">← 返回软考 · 章节学习</a>
      <p class="eyebrow">原 PDF 逐页阅读 · 教程第 2 版</p>
      <h1>{lesson.title}</h1>
      <p>第 {lesson.chapter} 章 · {chapter?.title} / 小节 {lesson.sectionIds.join("、")}</p>
      <div class="source-meta"><span>书内第 {pageLabel(lesson.printedStart, lesson.printedEnd)} 页</span><span>PDF 第 {pageLabel(lesson.pdfStart, lesson.pdfEnd)} 页</span><span>{lesson.reviewedOn} 整理</span></div>
    </header>
    <div class="study-grid">
      <article data-pagefind-body>
        <section class="paper intro"><span class="kicker">先抓住主线</span><p>{lesson.summary}</p><p class="small">第一轮按教材顺序理解本单元各小节，用少量练习检查理解；遇到不会的内容先记录疑问与错因，继续补齐知识面。通读之后，再按薄弱项和有来源的考试重点安排强化训练。</p><p class="small">以下按用户提供的原 PDF 页面整理，以自己的话解释教材。原创例子、练习与编者校注单独标识；不使用此前损坏的 OCR 文件。</p></section>
        <section class="paper learning" id="reading"><h2>按小节学习</h2>{lesson.blocks.map(block => <section id={`section-${block.id}`} class="knowledge-block"><div class="block-top"><h3>{sectionLabel(block.id)} {block.title}</h3><span>PDF {block.pdfPages.join("、")} 页</span></div>{block.paragraphs.map(paragraph => <p>{paragraph}</p>)}{block.points.length > 0 && <ul>{block.points.map(point => <li>{point}</li>)}</ul>}</section>)}</section>
        <section class="paper" id="example"><span class="kicker">编者补 · 原创例子</span><h2>{lesson.example.title}</h2><p>{lesson.example.body}</p></section>
        <section class="paper" id="pitfalls"><h2>容易混淆的地方</h2><ul>{lesson.pitfalls.map(point => <li>{point}</li>)}</ul></section>
        {(lesson.uncertainties.length > 0 || lesson.annotations?.length) && <section class="paper notes" id="notes"><h2>版本说明与核对备注</h2><ul>{lesson.uncertainties.map(note => <li>{note}</li>)}{lesson.annotations?.map(note => <li>{note.text} <a href={note.url} target="_blank" rel="noopener noreferrer">{note.title} ↗</a></li>)}</ul></section>}
        <section class="paper" id="practice"><span class="kicker">先作答，再看解析</span><h2>学完马上练</h2><RuankaoTextbookQuiz questions={lesson.questions} client:load /></section>
        <section class="paper" id="output"><h2>把知识用起来</h2><p>{lesson.practice}</p><details><summary>完成后查看参考答案与检查要点</summary><p>{lesson.practiceAnswer}</p></details></section>
        <section class="paper" id="review"><h2>闭卷复述清单</h2><ul>{lesson.keyPoints.map(point => <li>{point}</li>)}</ul><a class="return-button" href="/ruankao/?tab=today" data-no-swup>回到日计划与笔记，记录错因与收获 →</a></section>
        <nav class="lesson-nav" aria-label="相邻教材单元">{previous ? <a href={`/ruankao/textbook/${previous.id}/`} data-no-swup><small>上一单元</small>{previous.title}</a> : <span></span>}{next && <a href={`/ruankao/textbook/${next.id}/`} data-no-swup><small>下一单元</small>{next.title} →</a>}</nav>
      </article>
      <aside><div class="paper toc"><p class="kicker">本单元导航</p><a href="#reading">按小节学习</a>{lesson.blocks.map(block => <a class="sub" href={`#section-${block.id}`}>{sectionLabel(block.id)} {block.title}</a>)}<a href="#example">看一个例子</a><a href="#pitfalls">易错点</a><a href="#practice">原创练习 · {lesson.questions.length} 题</a><a href="#output">小实践</a><a href="#review">闭卷复述</a><p class="small">建议先读一组小节，再练题。篇幅较长时分两天完成，不必赶进度。</p></div><div class="paper source"><p class="kicker">教材依据</p><p>《系统架构设计师教程（第2版）》<br />清华大学出版社 · 2022 年<br />ISBN 9787302619925</p><p class="small">页码指本次原 PDF 与其印刷页码。考试时间、形式等以当次官方公告为准。</p><a href="https://www.tup.tsinghua.edu.cn/bookscenter/book_09190101.html" target="_blank" rel="noopener noreferrer">查看出版社书目信息 ↗</a></div></aside>
    </div>
  </div>
</MainGridLayout>
<style>
.textbook-study{--study-paper:#fffdf9;--study-soft:#f5f1e8;--study-line:#e2ded5;--study-muted:#637083;color:#263342;background:#f5f4f1;border-radius:14px;font-size:16px;line-height:1.95}.study-hero{padding:32px 36px;background:#111d2d;color:#f5f4f1;border-top:3px solid #d99a20;border-radius:14px}.back{font-size:12px;color:#dcb66b}.eyebrow,.kicker{font-size:11px;letter-spacing:.08em;color:#946514;font-weight:700}.eyebrow{color:#e5b558;margin-top:24px}.study-hero h1{font-size:30px;line-height:1.4;margin:10px 0}.study-hero>p:not(.eyebrow){font-size:13px;color:#c5ccd6}.source-meta{display:flex;gap:10px 20px;flex-wrap:wrap;font-size:11px;color:#c5ccd6;margin-top:18px}.study-grid{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:24px;padding:24px 0}.paper{background:var(--study-paper);border:1px solid var(--study-line);border-radius:12px;padding:28px;margin-bottom:20px;min-width:0;overflow-wrap:anywhere}.paper h2{font-size:21px;font-weight:700;margin-bottom:18px}.paper h3{font-size:18px;font-weight:700}.paper p{margin:14px 0;white-space:pre-line}.paper .small{font-size:12px;color:var(--study-muted);line-height:1.8}.paper ul{padding-left:1.25em;list-style:disc}.paper li{margin:10px 0}.paper a{color:#946514;text-decoration:underline;text-underline-offset:3px}.knowledge-block{padding:26px 0;border-top:1px solid var(--study-line);scroll-margin-top:90px}.knowledge-block:last-child{padding-bottom:0}.block-top>span{font-size:11px;color:var(--study-muted)}.toc{position:sticky;top:90px;padding:22px;max-height:calc(100dvh - 110px);overflow-y:auto}.toc a{display:block;text-decoration:none;font-size:13px;padding:6px 0}.toc .sub{font-size:12px;color:var(--study-muted);padding-left:10px}.source{font-size:12px}.notes{border-left:3px solid #d99a20;background:var(--study-soft)}details{margin-top:20px}summary{cursor:pointer;list-style:revert;color:#946514;font-size:14px}.return-button{display:inline-block;background:#111d2d;color:#f5f4f1!important;text-decoration:none!important;border-radius:8px;padding:10px 18px;font-size:13px;margin-top:20px}.lesson-nav{display:grid;grid-template-columns:1fr 1fr;gap:16px}.lesson-nav a{padding:18px;background:var(--study-paper);border:1px solid var(--study-line);border-radius:10px;font-size:13px}.lesson-nav small{display:block;color:var(--study-muted)}.lesson-nav a:last-child{text-align:right}section[id]{scroll-margin-top:90px}a:focus-visible,summary:focus-visible{outline:2px solid #d99a20;outline-offset:4px}:global(.dark) .textbook-study{--study-paper:#172333;--study-soft:#202c39;--study-line:#34414d;--study-muted:#a7b2c0;color:#e5e9ef;background:#111d2d}:global(.dark) .textbook-study .kicker,:global(.dark) .textbook-study a:not(.return-button){color:#dfaf54}@media(max-width:820px){.study-grid{grid-template-columns:1fr;padding:16px 10px}aside{grid-row:1}.toc{position:static;max-height:none;overflow-y:visible}.toc .sub{display:none}.source{display:none}.study-hero{padding:24px 22px}.study-hero h1{font-size:25px}.paper{padding:22px}.lesson-nav{gap:8px}.paper h2{font-size:20px}}
</style>
