---
import BookLibrary from "@components/BookLibrary.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getBooks } from "@utils/book-utils";

const books = await getBooks();
---

<MainGridLayout
	title="书籍"
	description="一手笔记的完整精读书目，按书浏览逐章阅读笔记。"
>
	<BookLibrary books={books} client:load />
</MainGridLayout>
