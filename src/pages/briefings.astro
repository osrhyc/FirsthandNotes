---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getBriefings } from "@utils/briefing-utils";
import { Icon } from "astro-icon/components";

const briefings = await getBriefings();
const [latestBriefing, ...pastBriefings] = briefings;

function formatDate(value: string) {
	return new Intl.DateTimeFormat("zh-CN", {
		year: "numeric",
		month: "long",
		day: "numeric",
		weekday: "short",
	}).format(new Date(`${value}T00:00:00`));
}
---

<MainGridLayout
	title="每日简报"
	description="每日整理值得关注的技术、商业、创业、营销与金融信息。"
>
	<div class="space-y-4">
		<header class="card-base px-6 py-6 md:px-8 md:py-7">
			<div class="flex items-start gap-4">
				<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--btn-regular-bg)] text-[var(--primary)]">
					<Icon name="material-symbols:newspaper-rounded" class="text-2xl" />
				</div>
				<div>
					<h1 class="text-2xl font-bold text-90 md:text-3xl">每日简报</h1>
					<p class="mt-2 max-w-2xl text-sm leading-6 text-50">
						筛选技术、商业、创业、营销、金融、股市和基金领域值得持续关注的信息。
					</p>
				</div>
			</div>
		</header>

		{latestBriefing && (
			<section>
				<div class="mb-3 px-1">
					<h2 class="text-lg font-bold text-90">最新一期</h2>
				</div>
				<a
					href={latestBriefing.url}
					class="card-base group block px-6 py-6 transition hover:-translate-y-0.5 md:px-8"
				>
					<div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
						<div class="min-w-0">
							<p class="text-sm font-semibold text-[var(--primary)]">
								{formatDate(latestBriefing.date)}
							</p>
							<h2 class="mt-2 text-xl font-bold leading-8 text-90 transition group-hover:text-[var(--primary)] md:text-2xl">
								{latestBriefing.title}
							</h2>
							<p class="mt-3 max-w-2xl text-sm leading-6 text-50">
								{latestBriefing.description}
							</p>
						</div>
						<span class="btn-regular flex h-10 shrink-0 items-center gap-2 rounded-lg px-4 text-sm font-medium">
							阅读简报
							<Icon name="material-symbols:arrow-forward-rounded" class="text-xl" />
						</span>
					</div>
				</a>
			</section>
		)}

		<section>
			<div class="mb-3 flex items-end justify-between gap-4 px-1">
				<div>
					<h2 class="text-lg font-bold text-90">历史简报</h2>
					<p class="mt-1 text-sm text-50">按日期从近到远排列</p>
				</div>
				<span class="text-sm text-30">{briefings.length} 期</span>
			</div>

			<div class="card-base overflow-hidden">
				{pastBriefings.length > 0 ? (
					<ol class="divide-y divide-black/5 dark:divide-white/10">
						{pastBriefings.map((briefing) => (
							<li>
								<a
									href={briefing.url}
									class="group flex min-h-20 items-center gap-4 px-6 py-4 transition hover:bg-[var(--btn-plain-bg-hover)] md:px-8"
								>
									<time class="w-24 shrink-0 text-sm text-30" datetime={briefing.date}>
										{briefing.date}
									</time>
									<div class="min-w-0 flex-1">
										<h3 class="font-semibold text-75 transition group-hover:text-[var(--primary)]">
											{briefing.title}
										</h3>
										<p class="mt-1 line-clamp-1 text-sm text-50">{briefing.description}</p>
									</div>
									<Icon name="material-symbols:chevron-right-rounded" class="shrink-0 text-xl text-30" />
								</a>
							</li>
						))}
					</ol>
				) : (
					<p class="px-6 py-8 text-center text-sm text-50">暂无历史简报</p>
				)}
			</div>
		</section>
	</div>
</MainGridLayout>
